PORT=5001

# Option 1: MongoDB installed on your own computer
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# Option 2: MongoDB Atlas (free cloud database). Replace USERNAME, PASSWORD and the host.
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/taskflow

# Any long random text. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
